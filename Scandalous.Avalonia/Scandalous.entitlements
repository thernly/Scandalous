<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- .NET's JIT allocates and executes memory at runtime; under the hardened
       runtime these three are required or the app crashes on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The self-contained publish loads its own unsigned-by-Apple native dylibs
       (Avalonia, NAPS2, Tesseract). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
