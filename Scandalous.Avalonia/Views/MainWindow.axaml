<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scandalous.Avalonia.ViewModels"
        xmlns:enums="using:Scandalous.Core.Enums"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="Scandalous.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Scandalous"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="300" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Controls panel -->
        <DockPanel Grid.Column="0">

            <!-- Status section — pinned to bottom -->
            <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,8" Spacing="4">
                <Separator Margin="0,0,0,4" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" />
                <!-- Avalonia 12 exposes polite live-region announcement through
                     AutomationProperties.LiveSetting; screen-reader support for it still
                     varies by platform backend. -->
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}}"
                           automation:AutomationProperties.Name="Scan status"
                           automation:AutomationProperties.LiveSetting="Polite"
                           ToolTip.Tip="{Binding CompletionToolTip}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <Button Content="Open PDF" Command="{Binding OpenPdfCommand}" IsVisible="{Binding CanOpenPdf}" />
                    <Button Content="Open Output Folder" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding CanOpenOutputFolder}" />
                </StackPanel>
                <TextBlock Text="{Binding CompletionWarningText}" Foreground="Orange" FontSize="11"
                           IsVisible="{Binding CompletionWarningText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding PageCount, StringFormat='Pages scanned: {0}'}" FontSize="12" />
            </StackPanel>

            <!-- Scrollable controls -->
            <ScrollViewer>
                <StackPanel Margin="12,12,12,4" Spacing="8">

                    <!-- Output section -->
                    <TextBlock Text="Output" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Name="OutputFolderLabel" Text="Output folder" FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding AreScanSettingsEnabled}">
                        <TextBlock Grid.Column="0" Text="{Binding OutputFolder}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Opacity="0.7" FontSize="12" Margin="0,0,6,0"
                                   automation:AutomationProperties.LabeledBy="{Binding #OutputFolderLabel}"
                                   ToolTip.Tip="{Binding OutputFolder}" />
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseOutputFolderCommand}"
                                Padding="8,4" FontSize="12"
                                automation:AutomationProperties.Name="Browse for output folder"
                                automation:AutomationProperties.HelpText="Choose the folder where scanned PDFs are saved." />
                    </Grid>
                    <TextBlock Text="{Binding OutputFolderError}"
                               Foreground="Red" FontSize="11"
                               IsVisible="{Binding OutputFolderError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="BaseFilenameLabel" Text="Base filename" FontSize="12" />
                    <TextBox Text="{Binding BaseFilename}" MaxLength="200" Padding="6,4"
                             IsEnabled="{Binding AreScanSettingsEnabled}"
                             automation:AutomationProperties.LabeledBy="{Binding #BaseFilenameLabel}"
                             automation:AutomationProperties.HelpText="Name used for the created PDF files, without an extension." />

                    <Separator Margin="0,2" />

                    <!-- Scanner section -->
                    <TextBlock Name="ScannerLabel" Text="Scanner" FontWeight="SemiBold" FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Scanners}"
                                  SelectedItem="{Binding SelectedScanner}"
                                  HorizontalAlignment="Stretch" Margin="0,0,6,0"
                                  IsEnabled="{Binding AreScanSettingsEnabled}"
                                  automation:AutomationProperties.LabeledBy="{Binding #ScannerLabel}" />
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding GetScannersCommand}"
                                Padding="8,4" FontSize="12"
                                IsEnabled="{Binding AreScanSettingsEnabled}"
                                automation:AutomationProperties.Name="Refresh scanner list" />
                    </Grid>
                    <TextBlock Text="{Binding SelectedScannerError}"
                               Foreground="Red" FontSize="11"
                               IsVisible="{Binding SelectedScannerError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                    <Separator Margin="0,2" />

                    <!-- Scan Options — inline, no Expander -->
                    <TextBlock Text="Scan Options" FontWeight="SemiBold" FontSize="12" />

                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,2,0,0"
                          IsEnabled="{Binding AreScanSettingsEnabled}">
                        <TextBlock Name="ColorModeLabel" Grid.Row="0" Grid.Column="0" Text="Color Mode" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ColorModeOptions}"
                                  SelectedItem="{Binding ColorMode}" HorizontalAlignment="Stretch" Margin="0,2"
                                  automation:AutomationProperties.LabeledBy="{Binding #ColorModeLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="enums:ScannerColorMode">
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Name="PaperSourceLabel" Grid.Row="1" Grid.Column="0" Text="Paper Source" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PaperSourceOptions}"
                                  SelectedItem="{Binding PaperSource}" HorizontalAlignment="Stretch" Margin="0,2"
                                  automation:AutomationProperties.LabeledBy="{Binding #PaperSourceLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="enums:ScannerPaperSource">
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Name="PaperSizeLabel" Grid.Row="2" Grid.Column="0" Text="Paper Size" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PaperSizeOptions}"
                                  SelectedItem="{Binding PaperSize}" HorizontalAlignment="Stretch" Margin="0,2"
                                  automation:AutomationProperties.LabeledBy="{Binding #PaperSizeLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="enums:ScannerPaperSize">
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Name="DocumentOptionLabel" Grid.Row="3" Grid.Column="0" Text="Document" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding DocumentOptionOptions}"
                                  SelectedItem="{Binding DocumentOption}" HorizontalAlignment="Stretch" Margin="0,2"
                                  automation:AutomationProperties.LabeledBy="{Binding #DocumentOptionLabel}"
                                  automation:AutomationProperties.HelpText="Create one combined PDF or a separate PDF per page.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="enums:DocumentOptions">
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Name="DpiLabel" Grid.Row="4" Grid.Column="0" Text="DPI" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" />
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DpiOptions}"
                                  SelectedItem="{Binding SelectedDpi}" HorizontalAlignment="Stretch" Margin="0,2"
                                  automation:AutomationProperties.LabeledBy="{Binding #DpiLabel}"
                                  automation:AutomationProperties.HelpText="Scan resolution in dots per inch." />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0"
                                IsEnabled="{Binding AreScanSettingsEnabled}">
                        <CheckBox Content="Auto Deskew" IsChecked="{Binding AutoDeskew}" />
                        <CheckBox Content="Exclude Blank Pages" IsChecked="{Binding ExcludeBlankPages}" />
                    </StackPanel>

                    <Separator Margin="0,2" />

                    <!-- OCR Settings -->
                    <Expander Header="OCR Settings" IsExpanded="{Binding IsOcrSettingsExpanded}" Padding="0"
                              IsEnabled="{Binding AreScanSettingsEnabled}">
                        <StackPanel Spacing="6" Margin="0,6,0,0">
                            <CheckBox Content="Enable OCR" IsChecked="{Binding OcrEnabled}" />
                            <TextBlock Name="TessdataFolderLabel" Text="Tessdata folder" FontSize="12" IsEnabled="{Binding OcrEnabled}" />
                            <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding OcrEnabled}">
                                <TextBlock Grid.Column="0" Text="{Binding TessdataFolder}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Opacity="0.7" FontSize="12" Margin="0,0,6,0"
                                           automation:AutomationProperties.LabeledBy="{Binding #TessdataFolderLabel}"
                                           ToolTip.Tip="{Binding TessdataFolder}" />
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseTessdataFolderCommand}"
                                        Padding="8,4" FontSize="12"
                                        automation:AutomationProperties.Name="Browse for tessdata folder"
                                        automation:AutomationProperties.HelpText="Choose the folder containing Tesseract traineddata files." />
                            </Grid>
                            <TextBlock Text="{Binding TessdataFolderError}"
                                       Foreground="Red" FontSize="11"
                                       IsVisible="{Binding TessdataFolderError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="OcrLanguageLabel" Text="OCR language" FontSize="12" IsEnabled="{Binding OcrEnabled}" />
                            <ComboBox ItemsSource="{Binding AvailableLanguageCodes}"
                                      SelectedItem="{Binding SelectedLanguageCode}"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding OcrEnabled}"
                                      automation:AutomationProperties.LabeledBy="{Binding #OcrLanguageLabel}" />
                            <TextBlock Text="{Binding NoOcrLanguagesText}"
                                       Foreground="Orange" FontSize="11"
                                       IsVisible="{Binding NoOcrLanguagesText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedLanguageCodeError}"
                                       Foreground="Red" FontSize="11"
                                       IsVisible="{Binding SelectedLanguageCodeError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Expander>

                    <!-- Scan / cancel buttons -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="Scan" Command="{Binding ScanCommand}"
                                Classes="accent"
                                HorizontalAlignment="Stretch"
                                FontSize="14"
                                Padding="0,8" />
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"
                                IsEnabled="{Binding CanCancelScan}"
                                automation:AutomationProperties.Name="Cancel scan"
                                FontSize="14"
                                Padding="0,8"
                                MinWidth="110"
                                Margin="8,0,0,0" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

        <!-- Image preview panel -->
        <Panel Grid.Column="2">
            <!-- Placeholder when no preview -->
            <TextBlock Text="No preview — scan a document to see results here"
                       IsVisible="{Binding PreviewImagePath, Converter={StaticResource IsNullConverter}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.5"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="20" />

            <!-- Preview image -->
            <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToBitmapConverter}}"
                   IsVisible="{Binding PreviewImagePath, Converter={StaticResource IsNotNullConverter}}"
                   Stretch="Uniform" />
        </Panel>

    </Grid>
</Window>
